# Copy to .env and fill in. Never commit .env.

# Supabase Postgres: use the pooler connection string (key=value or postgresql:// URI), e.g. the Session pooler
# postgresql://postgres.<ref>:<password>@aws-0-<region>.pooler.supabase.com:5432/postgres
# The direct db.<ref>.supabase.co:5432 host is IPv6-only on the free tier and fails on most home networks.
SUPABASE_CONNECTION_STRING=

# Research bridge (implementation-plan.md §6.6, docs/research.md). Empty = default shown.
# true/false (true)
RESEARCH_ENABLED=
# runner:model list in fallback order (agy:gemini-3.8-flash-medium,agy:claude-sonnet-4-6,claude-code:sonnet)
RESEARCH_RUNNERS=
# runs per WIB day across all runners (20)
RESEARCH_DAILY_CAP=
# jobs per scheduled batch (8)
RESEARCH_BATCH_CAP=
# per-model daily caps, glob on model or runner:model, e.g. claude-*:6,agy:gemini-*:12 (none)
RESEARCH_MODEL_CAPS=
# also run a 12:05 WIB midday batch (false)
RESEARCH_MIDDAY=
# timeout per runner call in seconds (240)
RESEARCH_TIMEOUT_SECONDS=
# max age of cited sources in days (14)
RESEARCH_SOURCE_MAX_AGE_DAYS=
# reuse a stock insight younger than this many hours (6)
RESEARCH_STOCK_CACHE_HOURS=
# folder the headless agent runs in (research-workspace/ next to the repo, or %LOCALAPPDATA%\Sumire\research-workspace)
RESEARCH_WORKSPACE=

# Forecasting (implementation-plan.md §5.4, docs/forecasting.md)
# off | actions | local (actions, the default: GitHub Actions writes forecasts)
FORECAST_MODE=
FORECAST_MODEL_REPO=
FORECAST_MODEL_REVISION=
FORECAST_MODEL_FILE=
FORECAST_MODEL_SHA256=
FORECAST_MODEL_CACHE=
# true: run `forecast --once` locally at 18:00 WIB when Actions wrote nothing today
FORECAST_LOCAL_FALLBACK=
HF_TOKEN=

# Optional paid API runners (off by default)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
