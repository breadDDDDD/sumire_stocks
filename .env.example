# Copy to .env and fill in. Never commit .env.

# Supabase Postgres: use the pooler connection string (key=value or postgresql:// URI).
# The direct db.<ref>.supabase.co host is IPv6-only on the free tier.
SUPABASE_CONNECTION_STRING=

# Research bridge (implementation-plan.md §6.6)
RESEARCH_ENABLED=
RESEARCH_RUNNERS=
RESEARCH_DAILY_CAP=
RESEARCH_BATCH_CAP=
RESEARCH_MODEL_CAPS=

# Forecasting (implementation-plan.md §5.4)
FORECAST_MODE=
FORECAST_MODEL=
FORECAST_MODEL_REPO=
FORECAST_MODEL_REVISION=
FORECAST_MODEL_SHA256=
FORECAST_LOCAL_FALLBACK=
HF_TOKEN=

# Optional paid API runners (off by default)
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
